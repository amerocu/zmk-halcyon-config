#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    combos {
        compatible = "zmk,combos";
        combo_sd {
            timeout-ms = <50>;
            key-positions = <14 15>;
            bindings = <&kp TAB>;
        };
        combo_df {
            timeout-ms = <50>;
            key-positions = <15 16>;
            bindings = <&kp ESC>;
        };
        combo_jk {
            timeout-ms = <50>;
            key-positions = <19 20>;
            bindings = <&kp DQT>;
        };
        combo_kl {
            timeout-ms = <50>;
            key-positions = <20 21>;
            bindings = <&kp SQT>;
        };
        combo_er {
            timeout-ms = <50>;
            key-positions = <3 4>;
            bindings = <&tog 4>;
        };
        combo_ui {
            timeout-ms = <50>;
            key-positions = <7 8>;
            bindings = <&tog 3>;
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
// -----------------------------------------------------------------------------------------
// |      |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  |      |
// |      |GUI/A|Alt/S|Ctl/D|Shf/F|  G  |   |  H  |Shf/J|Ctl/K|Alt/L|GUI/;|      |
// |      |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  |  /  |      |
//                    | GUI |Shf/ |Nav/ |   |Sym/ |Ctl/ |Alt/ |
//                    |     |Spc  |Del  |   |Bsp  |Spc  |Ent  |
// |     |     |     |     |     |   |     |     |     |     |     |
// |     |     |     |     |     |   |     |     |     |     |     |
            bindings = <
&none      &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &none
&none      &mt LGUI A &mt LALT S &mt LCTRL D &mt LSHFT F &kp G   &kp H &mt RSHFT J &mt LCTRL K &mt RALT L &mt RGUI SEMI &none
&none      &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &none
               &kp LGUI &mt RSHFT SPACE &lt 2 DEL   &lt 1 BSPC &mt LCTRL SPACE &mt LALT ENTER

&none &none &none &none &none                          &none &none &none &none &none

            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        sym_layer {
            display-name = "Sym";
// -----------------------------------------------------------------------------------------
// |      |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  |      |
// |      |GUI/~|Alt/<|Ctl/[|Shf/(|  {  |   |  }  |Shf/)|Ctl/]|Alt/>|GUI/`|      |
// |      |  \  |  ?  |  |  |  -  |  _  |   |  =  |  +  |  ,  |  .  |  /  |      |
//                    |     |     |     |   |     |     |     |
//                    |     |     |     |   |     |     |     |
// |     |     |     |     |     |   |     |     |     |     |     |
// |     |     |     |     |     |   |     |     |     |     |     |
            bindings = <
&none      &kp N1 &kp N2 &kp N3 &kp N4 &kp N5   &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &none
&none      &mt LGUI TILDE &mt LALT LT &mt LCTRL LBKT &mt LSHFT LPAR &kp LBRC   &kp RBRC &mt RSHFT RPAR &mt LCTRL RBKT &mt RALT GT &mt RGUI GRAVE &none
&none      &kp BSLH &kp QUESTION &kp PIPE &kp MINUS &kp UNDER   &kp EQUAL &kp PLUS &kp COMMA &kp DOT &kp FSLH &none
               &trans &trans &trans   &trans &trans &trans

&trans &trans &trans &trans &trans                          &trans &trans &trans &trans &trans

            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        nav_layer {
            display-name = "Nav";
// -----------------------------------------------------------------------------------------
// |      |     |     |     |     |     |   |Home |PgDn |PgUp |End  |VolUp|Del  |
// |      | GUI | Alt | Ctrl |Shift|     |   |Left |Down | Up  |Right|Mute |Ins  |
// |      |     |     |     |     |     |   |Prev |Play |Pause|Next |VolDn|PrtSc|
//                    |     |     |     |   |     |     |     |
//                    |     |     |     |   |     |     |     |
// |     |     |     |     |     |   |     |     |     |     |     |
// |     |     |     |     |     |   |     |     |     |     |     |
            bindings = <
&none      &none &none &none &none &none   &kp HOME &kp PG_DN &kp PG_UP &kp END &kp C_VOL_UP &kp DEL
&none      &kp LGUI &kp LALT &kp LCTRL &kp LSHFT &none   &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp C_MUTE &kp INS
&none      &none &none &none &none &none   &kp C_PREV &kp C_PLAY_PAUSE &kp C_PAUSE &kp C_NEXT &kp C_VOL_DN &kp PSCRN
               &trans &trans &trans   &trans &trans &trans

&trans &trans &trans &trans &trans                          &trans &trans &trans &trans &trans

            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        function_layer {
            display-name = "Function";
// -----------------------------------------------------------------------------------------
// | BOOT |  F1 |  F2 |  F3 |  F4 |  F5 |   |  F6 |  F7 |  F8 |  F9 | F10 |      |
// |      | F11 | F12 |     |     |     |   | BOOT|     |     |     |     |      |
// |      |     |     |     |     |     |   |     |     |     |     |     |      |
//                    |     |     |     |   |     |     |     |
//                    |     |     |     |   |     |     |     |
// |     |     |     |     |     |   |     |     |     |     |     |
// |     |     |     |     |     |   |     |     |     |     |     |
            bindings = <
&bootloader &kp F1 &kp F2 &kp F3 &kp F4 &kp F5   &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &none
&none      &kp F11 &kp F12 &none &none &none   &bootloader &none &none &none &none &none
&none      &none &none &none &none &none   &none &none &none &none &none &none
               &trans &trans &trans   &trans &trans &trans

&trans &trans &trans &trans &trans                          &trans &trans &trans &trans &trans

            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        adjust_layer {
            display-name = "Adjust";
// -----------------------------------------------------------------------------------------
// | BOOT |STDIO|     |QWERTY|     |     |   |     |     |     |     |     |     |
// |      |RGBON|RGBHU|RGBSA|RGBBR|RGBEF|   |     |     |     |     |     |     |
// |      |RGBOF|RGBHD|RGBSD|RGBBD|RGBER|   |     |     |     |     |     |     |
//                    |     |     |     |   |     |     |     |
//                    |     |     |     |   |     |     |     |
// |     |     |     |     |     |   |     |     |     |     |     |
// |     |     |     |     |     |   |     |     |     |     |     |
            bindings = <
&bootloader &studio_unlock &none &to 0 &none &none   &none &none &none &none &none &none
&none      &rgb_ug RGB_ON &rgb_ug RGB_HUI &rgb_ug RGB_SAI &rgb_ug RGB_BRI &rgb_ug RGB_EFF   &none &none &none &none &none &none
&none      &rgb_ug RGB_OFF &rgb_ug RGB_HUD &rgb_ug RGB_SAD &rgb_ug RGB_BRD &rgb_ug RGB_EFR   &none &none &none &none &none &none
               &trans &trans &trans   &trans &trans &trans

&trans &trans &trans &trans &trans                          &trans &trans &trans &trans &trans

            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
